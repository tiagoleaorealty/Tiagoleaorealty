# Secrets — never commit these.
# The repo is public: anything committed here is readable by anyone, and bots
# scan public repos for keys within minutes of a push.
.env
.env.*
!.env.example
*.key
secrets.json

# Build artifacts — build.py regenerates these on every Vercel deploy.
# They are output, not source; committing them would just go stale.
/property/
/school/
/blog/
/signature/

# macOS
.DS_Store
**/.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Video masters. Source footage stays local — only the encoded hero loop
# (hero.mp4 / hero.webm) is committed. A 78 MB .mov in a public repo's
# history would be permanent and unremovable.
*.mov
*.MOV
*.mp4
*.webm
!hero.mp4
!hero.webm
